# LifeOS Backend Environment Configuration
# Copy this to .env and fill in your values

# Database
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/lifeos

# Security
SECRET_KEY=your-super-secret-key-change-in-production

# AI Provider: "openai" or "groq"
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile

# API Keys (set the one matching your AI_PROVIDER)
OPENAI_API_KEY=
GROQ_API_KEY=

# Debug mode
DEBUG=false
