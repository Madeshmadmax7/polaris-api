# LifeOS Environment Configuration

# App
APP_NAME=LifeOS
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=lifeos-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./lifeos.db

# AI Providers
OPENAI_API_KEY=sk-dummy-openai-key
GROQ_API_KEY=gsk_dummy-groq-key
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile

# RAG / Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_DIR=./faiss_indices
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5

# CORS - Using 127.0.0.1 to avoid IPv6 issues
CORS_ORIGINS=["http://127.0.0.1:5173", "http://localhost:5173", "chrome-extension://*"]

# WebSocket
WS_HEARTBEAT_INTERVAL=5
